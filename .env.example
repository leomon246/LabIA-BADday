# Copia este archivo a .env (NO se sube a Git) y completa tus valores.
# Claves gratuitas: https://aistudio.google.com/apikey  (cada desarrollador usa las suyas)
# Dos claves obligatorias (cada una tiene su propia cuota gratuita) y una tercera opcional:

# 1) GUION / investigación (agente "investigador", código de backend/)
GEMINI_API_KEY_GUION=
# Modelo del guion: pon uno que tu cuenta tenga disponible
GEMINI_MODEL=gemini-3.8-flash
# Segundos de espera por modelo antes de pasar al de respaldo (si el principal está saturado)
#GEMINI_TIMEOUT_S=50
# Respaldo si ese modelo está saturado (503) o sin cuota; separados por coma
#GEMINI_MODEL_RESPALDO=gemini-3-flash-preview,gemini-3.1-flash-lite

# 2) DIAPOSITIVAS (agente "presentador")
GEMINI_API_KEY=
# Opcional: primer modelo que prueba el presentador
#GEMINI_MODELO=gemini-3.8-flash

# 3) VOZ (el Presentador "ensaya" y habla; la graba el agente "locutor", que no tiene personaje en la escena).
# La cuota gratis de Gemini TTS es pequeña (pocas peticiones por minuto, POR MODELO Y POR PROYECTO), asi que la voz
# usa un pool = todas las claves distintas que existan x todos los modelos de voz, en paralelo, esquivando los 429.
# Claves que usa (las que existan, sin repetir): GEMINI_API_KEY_VOZ, GEMINI_API_KEY_VOZ2, GEMINI_API_KEY, GEMINI_API_KEY_GUION.
# Con dos desarrolladores: cada uno pone su clave aqui (de un proyecto distinto de AI Studio = cuota distinta).
#GEMINI_API_KEY_VOZ=
#GEMINI_API_KEY_VOZ2=
# Modelos de voz, separados por coma (por defecto estos cuatro; comprueba cuales ve tu cuenta con agentes.claves)
#GEMINI_TTS_MODELOS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
#GEMINI_VOZ=Kore
# Sin voz IA (cuota, sin clave, sin red) la escena narra con la voz del navegador, diapositiva por diapositiva.

# Solo para correr backend/ por separado (python backend/servidor.py)
LLM_GUION=gemini
# Ollama: OPCIONAL, no necesario para el flujo principal
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
API_PORT=8001
