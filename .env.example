# Copia este archivo a .env (NO se sube a Git) y completa tus valores.

# LLM principal (guion, investigación): gemini | ollama
LLM_GUION=gemini
# Clave gratuita: https://aistudio.google.com/apikey  (cada desarrollador usa la suya)
GEMINI_API_KEY=
# Modelo: pon el que tu cuenta tenga disponible en el nivel gratuito (el equipo usa otro distinto a este valor)
GEMINI_MODEL=gemini-2.5-flash

# Ollama: OPCIONAL, no necesario para el flujo principal
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

API_PORT=8001
